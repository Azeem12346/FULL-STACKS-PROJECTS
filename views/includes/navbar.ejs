<style>

    /* ================= SEARCH BUTTON ================= */

    .btn-search {
        background-color: #fe424d;
        color: white;
        border-radius: 25px;
        padding: 0 1rem;
        border: none;
        white-space: nowrap;
    }

    .btn-search:hover {
        background-color: #fe424d;
        color: white;
    }

    .btn-search i {
        display: inline;
        margin-right: 0.5rem;
    }

    .search-inp {
        border-radius: 25px;
        padding: 0.5rem 3rem;
        font-size: 1rem;
    }


    /* ================= THEME BUTTON ================= */

    #themeToggle {
        border: 1px solid #ccc;
        background: transparent;
        color: #222;
        border-radius: 8px;
        padding: 6px 12px;
        margin: 5px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    #themeToggle:hover {
        background-color: #f1f1f1;
    }


    /* ================= HAMBURGER BUTTON ================= */

    .custom-toggler {
        border: 2px solid #555 !important;
        border-radius: 10px;
        width: 48px;
        height: 42px;
        padding: 7px 8px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 5px;
        background: transparent;
        cursor: pointer;
    }

    .custom-toggler:focus {
        box-shadow: none !important;
        outline: none;
    }

    .hamburger-line {
        display: block;
        width: 24px;
        height: 3px;
        background-color: #333;
        border-radius: 5px;
        transition: all 0.3s ease;
    }


    /* ================= MOBILE NAVBAR ================= */

    @media (max-width: 767.98px) {

        .navbar {
            min-height: 5rem;
            padding: 0.7rem 0.8rem;
        }

        .navbar-brand {
            margin-right: 0;
        }

        .fa-compass {
            font-size: 2rem;
        }


        /* Hamburger */

        .custom-toggler {
            margin-left: auto;
            flex-shrink: 0;
        }


        /* Mobile Menu */

        .navbar-collapse {
            margin-top: 1rem;
            padding: 1rem;
            border-radius: 12px;
            background-color: #ffffff;
            border: 1px solid #ddd;
            width: 100%;
        }


        .navbar-nav {
            width: 100%;
        }


        .navbar-nav .nav-link {
            padding: 0.7rem 0;
            font-size: 1rem;
        }


        /* Search */

        .navbar-search {
            margin: 0 !important;
        }

        .navbar-search form {
            display: flex;
            width: 100%;
            gap: 0.4rem;
        }

        .search-inp {
            width: 100%;
            padding: 0.6rem 1rem;
        }

        .btn-search {
            padding: 0.6rem 1rem;
        }


        /* Right side */

        .navbar-right {
            margin: 0 !important;
            align-items: flex-start;
        }

        #themeToggle {
            margin: 0.5rem 0;
        }

    }


    /* ================= DARK MODE ================= */

    body.dark .navbar-collapse {
        background-color: #1b1b1b !important;
        border-color: #444;
    }


    body.dark .custom-toggler {
        border-color: #777 !important;
        background-color: #1b1b1b;
    }


    body.dark .hamburger-line {
        background-color: #ffffff;
    }


    body.dark #themeToggle {
        color: white;
        border-color: #666;
        background-color: #2a2a2a;
    }


    body.dark #themeToggle:hover {
        background-color: #333;
    }

</style>


<!-- ================= NAVBAR ================= -->

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">

    <div class="container-fluid">


        <!-- ================= LOGO ================= -->

        <a class="navbar-brand" href="/listings">

            <i class="fa-regular fa-compass"></i>

        </a>


        <!-- ================= MOBILE HAMBURGER ================= -->

        <button
            class="navbar-toggler custom-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNavAltMarkup"
            aria-controls="navbarNavAltMarkup"
            aria-expanded="false"
            aria-label="Toggle navigation"
        >

            <span class="hamburger-line"></span>

            <span class="hamburger-line"></span>

            <span class="hamburger-line"></span>

        </button>


        <!-- ================= NAVBAR CONTENT ================= -->

        <div
            class="collapse navbar-collapse"
            id="navbarNavAltMarkup"
        >


            <!-- ================= EXPLORE ================= -->

            <div class="navbar-nav">

                <a
                    class="nav-link"
                    href="/listings"
                >
                    Explore
                </a>

            </div>


            <!-- ================= SEARCH ================= -->

            <div class="navbar-nav ms-auto navbar-search">

                <form
                    action="/listings"
                    method="GET"
                    class="d-flex"
                >

                    <input
                        class="form-control me-2 search-inp"
                        type="text"
                        name="search"
                        placeholder="Search destinations"
                    >

                    <button
                        class="btn btn-search"
                        type="submit"
                    >

                        <i class="fa-solid fa-magnifying-glass"></i>

                        Search

                    </button>

                </form>

            </div>


            <!-- ================= RIGHT SIDE ================= -->

            <div class="navbar-nav ms-auto navbar-right">


                <!-- DARK MODE -->

                <button
                    id="themeToggle"
                    type="button"
                >
                    Dark 🌙
                </button>


                <!-- ADD NEW -->

                <a
                    class="nav-link"
                    href="/listings/new"
                >
                    Add New
                </a>


                <!-- ================= USER NOT LOGGED IN ================= -->

                <% if(!currUser) { %>

                    <!-- SIGN UP -->

                    <a
                        class="nav-link"
                        href="/signup"
                    >
                        <b>Sign up</b>
                    </a>


                    <!-- LOGIN -->

                    <a
                        class="nav-link"
                        href="/login"
                    >
                        <b>Log in</b>
                    </a>

                <% } %>


                <!-- ================= USER LOGGED IN ================= -->

                <% if(currUser) { %>

                    <!-- LOGOUT -->

                    <a
                        class="nav-link"
                        href="/logout"
                    >
                        <b>Log out</b>
                    </a>

                <% } %>


            </div>


        </div>

    </div>

</nav>